Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.25
      Plane Cell Count: 16
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Workcell (robot, table, wrist camera)
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Names: true
      Marker Scale: 0.15
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Wrist ZED point cloud
      Color Transformer: RGB8
      Decay Time: 0
      Size (m): 0.004
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cam3/points
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detected boxes
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cam3/detections/markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: View cones
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vision/fov_cones
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Wrist ZED left
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cam3/left/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Wrist ZED right
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cam3/right/image_raw
      Value: false
  Global Options:
    Fixed Frame: world
    Background Color: 238; 240; 243
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 4.2
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.9
      Pitch: 0.45
      Yaw: 0.9
      Target Frame: world
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
