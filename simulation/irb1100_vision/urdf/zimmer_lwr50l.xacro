<?xml version="1.0"?>
<!--
  Zimmer MATCH LWR50L-23-00006-A (lightweight changer gripper, 2-jaw parallel).

  FROM THE ZIMMER DATASHEET DRAWINGS (MER_GD_PG_LWR50L-23-00006-A V1), mm, z = 0 at the mating face (robot side):
    coupling plate dia 75 x 18 + lock collar (~29 total); body 53.8 x 22.3 from z = 29 to 106; jaws 10.5 wide, 21.5 long to z = 127.5;
    jaw gap 32.8 open / 12.8 closed (10 mm stroke per jaw); two locating tabs on the 43 mm axis; four dowels at (+-7, +-23);
    cable loop on -y, ~96 mm overall width; weight 0.725 kg; max finger length 80 mm, finger mass 0.1 kg.
  VISUAL: the real Zimmer CAD (meshes/zimmer_lwr50l.stl from the STEP in zed_wrist/). The STEP has the jaws open.
  COLLISION / INERTIA: boxes and cylinders from the datasheet numbers above (fast in Gazebo); inertia = uniform box, an estimate.
    Fingers are customer parts: NONE modelled.
  HEAD: the robot-side LWR50F module (black ring with the LED) sits between the flange and the gripper. head_len = 15.3 mm
    = WP1's TCP 142.8 mm minus our 127.5 mm; modelled as a plain cylinder. TCP from the flange = head_len + tcp_z = 142.8 mm.
  TCP default = jaw end face at z = 0.1275 m from the gripper mating face; add the real finger length for the fingertip.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="zimmer_lwr50l" params="parent tcp_z:=0.1275 head_len:=0.0153">
    <link name="gripper_link">
      <!-- real shape: Zimmer STEP LWR50L-23-00006-A (zed_wrist/) without the jaws, meshed by zed_wrist/export_sim_meshes.py; z = 0 at the mating face, +z to the jaws -->
      <visual>
        <geometry><mesh filename="package://irb1100_vision/meshes/zimmer_lwr50l.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="gripper_black"/>
      </visual>
      <!-- collision: simple shapes from the datasheet (fast) -->
      <collision><origin xyz="0 0 0.0145"/><geometry><cylinder radius="0.0375" length="0.029"/></geometry></collision>
      <collision><origin xyz="0 0 0.0675"/><geometry><box size="0.0223 0.0538 0.077"/></geometry></collision>
      <inertial>
        <origin xyz="0 0 0.062"/>
        <mass value="0.725"/><!-- Zimmer datasheet; head (LWR50F) not included -->
        <inertia ixx="0.00116" ixy="0" ixz="0" iyy="0.00102" iyz="0" izz="0.00022"/>
      </inertial>
    </link>
    <!-- LWR50F head: plain cylinder (no CAD), flange to the gripper mating face -->
    <link name="gripper_head_link">
      <visual><origin xyz="0 0 ${head_len/2}"/><geometry><cylinder radius="0.0375" length="${head_len}"/></geometry><material name="gripper_black"/></visual>
      <collision><origin xyz="0 0 ${head_len/2}"/><geometry><cylinder radius="0.0375" length="${head_len}"/></geometry></collision>
      <inertial><origin xyz="0 0 ${head_len/2}"/><mass value="0.1"/><inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="7e-5"/></inertial>
    </link>
    <joint name="tool0_to_gripper_head" type="fixed">
      <parent link="${parent}"/><child link="gripper_head_link"/><origin xyz="0 0 0"/>
    </joint>
    <joint name="tool0_to_gripper" type="fixed">
      <parent link="gripper_head_link"/><child link="gripper_link"/><origin xyz="0 0 ${head_len}"/>
    </joint>

    <!-- jaws: 10 mm stroke each (datasheet), 0 = open (gap 32.8 mm), 0.010 = closed. Controlled by gripper_controller. -->
    <xacro:macro name="zimmer_jaw" params="side sign">
      <link name="jaw_${side}_link">
        <visual>
          <geometry><mesh filename="package://irb1100_vision/meshes/zimmer_jaw_${side}.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="gripper_alu"/>
        </visual>
        <collision><origin xyz="0 ${sign*0.02165} 0.11675"/><geometry><box size="0.0100 0.0105 0.0215"/></geometry></collision>
        <inertial><origin xyz="0 ${sign*0.02165} 0.11"/><mass value="0.02"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
      </link>
      <joint name="jaw_${side}" type="prismatic">
        <parent link="gripper_link"/><child link="jaw_${side}_link"/><origin xyz="0 0 0"/>
        <axis xyz="0 ${-sign} 0"/>
        <limit lower="0" upper="0.010" effort="200" velocity="0.05"/>
      </joint>
    </xacro:macro>
    <xacro:zimmer_jaw side="left" sign="1"/>
    <xacro:zimmer_jaw side="right" sign="-1"/>
    <ros2_control name="gripper_gz" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <joint name="jaw_left"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
      <joint name="jaw_right"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    </ros2_control>
    <!-- holding: a box is fixed to the wrist while gripped (gz DetachableJoint, switched by scripts/gripper.py); jaw friction alone is unreliable in sim -->
    <xacro:macro name="grip_box" params="box">
      <gazebo>
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
          <parent_link>link_6</parent_link>
          <child_model>${box}</child_model>
          <child_link>link</child_link>
          <attach_topic>/grip/${box}/attach</attach_topic>
          <detach_topic>/grip/${box}/detach</detach_topic>
        </plugin>
      </gazebo>
    </xacro:macro>
    <xacro:grip_box box="box_red"/>
    <xacro:grip_box box="box_blue"/>
    <xacro:grip_box box="box_green"/>

    <link name="gripper_tcp"/>
    <joint name="gripper_to_tcp" type="fixed">
      <parent link="gripper_link"/><child link="gripper_tcp"/><origin xyz="0 0 ${tcp_z}"/>
    </joint>
  </xacro:macro>
</robot>
