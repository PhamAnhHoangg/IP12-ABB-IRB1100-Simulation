<?xml version="1.0"?>
<!--
  vision_camera: a camera on the 3D-printed clamp (meshes/camera_mount_*.stl).

  The camera is placed by WHERE THE CAMERA IS (cx cy cz, world), its heading (yaw) and
  its downward pitch (tilt = the clamp tilt angle). The clamp/pole position is derived from that,
  using (pcx, pcz) = camera centre in the clamp frame, printed by cad/camera_mount.py.

  Frames: <name>_link        x forward, y left, z up (ROS body convention)
          <name>_optical_frame  z forward, x right, y down (image frame)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="stereo_eye" params="name side y lens_x hfov width height fps clip_far">
    <link name="${name}_${side}_optical_frame"/>
    <joint name="${name}_link_to_${side}_optical" type="fixed">
      <parent link="${name}_link"/><child link="${name}_${side}_optical_frame"/>
      <origin xyz="${lens_x} ${y} 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <gazebo reference="${name}_link">
      <sensor name="${name}_${side}" type="camera">
        <pose>${lens_x} ${y} 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${fps}</update_rate>
        <visualize>false</visualize>
        <topic>${name}/${side}/image_raw</topic>
        <gz_frame_id>${name}_${side}_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image><width>${width}</width><height>${height}</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>${clip_far}</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="vision_camera"
               params="name cx cy cz yaw tilt pcx pcz mesh hfov:=1.2 width:=1280 height:=720 fps:=15 clip_far:=5.0 body:='0.090 0.025 0.025' baseline:=0.0 lens_x:=0.0">

    <!-- clamp frame: yaw only, tube axis vertical -->
    <link name="${name}_mount">
      <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
      <visual>
        <geometry><mesh filename="package://irb1100_vision/meshes/${mesh}" scale="0.001 0.001 0.001"/></geometry>
        <material name="print_grey"/>
      </visual>
    </link>
    <joint name="world_to_${name}_mount" type="fixed">
      <parent link="world"/><child link="${name}_mount"/>
      <origin xyz="${cx - pcx*cos(yaw)} ${cy - pcx*sin(yaw)} ${cz - pcz}" rpy="0 0 ${yaw}"/>
    </joint>

    <gazebo reference="world_to_${name}_mount"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="${name}_mount_to_link"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <link name="${name}_link">
      <inertial><mass value="0.06"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
      <visual><geometry><box size="${body}"/></geometry><material name="${name}_color"/></visual>
    </link>
    <joint name="${name}_mount_to_link" type="fixed">
      <parent link="${name}_mount"/><child link="${name}_link"/>
      <origin xyz="${pcx} 0 ${pcz}" rpy="0 ${tilt} 0"/>
    </joint>

    <link name="${name}_optical_frame"/>
    <joint name="${name}_link_to_optical" type="fixed">
      <parent link="${name}_link"/><child link="${name}_optical_frame"/>
      <origin xyz="${lens_x} 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <xacro:if value="${baseline == 0.0}">
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="camera">
        <always_on>true</always_on>
        <update_rate>${fps}</update_rate>
        <visualize>false</visualize>
        <topic>${name}/image_raw</topic>
        <gz_frame_id>${name}_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image><width>${width}</width><height>${height}</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>${clip_far}</far></clip>
        </camera>
      </sensor>
    </gazebo>
    </xacro:if>

    <!-- stereo pair (baseline > 0): left/right optical frames and two gz sensors, +-baseline/2 along the body y axis -->
    <xacro:if value="${baseline > 0.0}">
      <xacro:stereo_eye name="${name}" side="left"  y="${baseline/2}"  lens_x="${lens_x}" hfov="${hfov}" width="${width}" height="${height}" fps="${fps}" clip_far="${clip_far}"/>
      <xacro:if value="$(arg cam2_right)">
      <xacro:stereo_eye name="${name}" side="right" y="${-baseline/2}" lens_x="${lens_x}" hfov="${hfov}" width="${width}" height="${height}" fps="${fps}" clip_far="${clip_far}"/>
      </xacro:if>
    </xacro:if>
  </xacro:macro>
</robot>
