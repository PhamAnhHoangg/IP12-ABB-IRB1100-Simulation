<?xml version="1.0"?>
<!--
  ZED Mini on the 3D-printed wrist mount (zed_wrist/ in the repo root), clamped onto the Zimmer gripper. The only camera in the cell.
  Mount mesh and camera position come from zed_wrist/export_sim_meshes.py (same CAD as the printed parts).
  The camera sits about 80 mm off to the gripper's -x side. tilt_deg (launch: cam_tilt) turns it towards the gripper axis:
  0 (default) = parallel to it, straight down when the gripper points down; 25 = the printed wedge, jaws in the picture.
  The print (TILT_DEG in zed_wrist/zed_wrist_parts.py) is still 25; for 0 set TILT_DEG = 0 and reprint the wedge (it becomes a 5 mm spacer).

  Frames: cam3_link              x = viewing direction, y = along the stereo baseline, z = away from the gripper
          cam3_left/right_optical_frame   z forward, x right, y down (image frames, +-31.5 mm)
  Gazebo: left eye = RGB-D sensor (colour + depth + point cloud, like the ZED's depth output, which is aligned to the left image),
          right eye = colour only. 90 deg HFOV. ROS topics (config/bridge.yaml): /cam3/left/image_raw, /cam3/right/image_raw,
          /cam3/depth/image_raw (32FC1, metres), /cam3/points (PointCloud2), /cam3/left|right/camera_info.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="zed_eye" params="name side y width height fps sensor:=true depth:=false">
    <link name="${name}_${side}_optical_frame"/>
    <joint name="${name}_link_to_${side}_optical" type="fixed">
      <parent link="${name}_link"/><child link="${name}_${side}_optical_frame"/>
      <origin xyz="0.01325 ${y} 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <xacro:if value="${sensor}">
    <gazebo reference="${name}_link">
      <sensor name="${name}_${side}" type="${'rgbd_camera' if depth else 'camera'}">
        <pose>0.01325 ${y} 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${fps}</update_rate>
        <visualize>false</visualize>
        <topic>${name}/${side}${'' if depth else '/image_raw'}</topic>   <!-- rgbd: <topic>/image, /depth_image, /points, /camera_info -->
        <gz_frame_id>${name}_${side}_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>${pi/2}</horizontal_fov>
          <image><width>${width}</width><height>${height}</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>5.0</far></clip>
          <depth_camera><clip><near>0.1</near><far>5.0</far></clip></depth_camera>   <!-- ZED Mini depth starts at about 0.1 m -->
        </camera>
      </sensor>
    </gazebo>
    </xacro:if>
  </xacro:macro>

  <!-- tilt_deg: 0 = camera parallel to the gripper axis, looking straight down when the gripper does (default);
       25 = the printed wedge in zed_wrist/ (camera turned towards the gripper axis, jaws in the picture).
       The wedge turns the box about its hinge at the collar, so the camera position follows the angle:
       CAD centres (zed_wrist/export_sim_meshes.py) 0 deg (-80.5, 0, 13.75) mm, 25 deg (-84.3, 0, 23.2) mm. -->
  <xacro:macro name="zed_wrist" params="parent:=gripper_link name:=cam3 tilt_deg:=0 right:=true width:=1280 height:=720 fps:=15">
    <xacro:property name="tr" value="${tilt_deg*pi/180}"/>
    <link name="${name}_wrist_mount">
      <inertial><mass value="0.12"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
      <visual>
        <!-- zed_wrist_mount.stl = the 25 deg print, zed_wrist_mount_tilt0.stl = flat spacer instead of the wedge -->
        <geometry><mesh filename="package://irb1100_vision/meshes/zed_wrist_mount${'_tilt0' if tilt_deg == 0 else ''}.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="print_grey"/>
      </visual>
    </link>
    <joint name="${parent}_to_${name}_wrist_mount" type="fixed">
      <parent link="${parent}"/><child link="${name}_wrist_mount"/><origin xyz="0 0 0"/>
    </joint>

    <link name="${name}_link">
      <inertial><mass value="0.063"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
      <visual><geometry><box size="0.0265 0.1245 0.0305"/></geometry><material name="cam3_color"/></visual>
    </link>
    <joint name="${name}_wrist_mount_to_link" type="fixed">
      <parent link="${name}_wrist_mount"/><child link="${name}_link"/>
      <origin xyz="${-(0.061 + 0.0195*cos(tr) + 0.01325*sin(tr))} 0 ${0.027 + 0.0195*sin(tr) - 0.01325*cos(tr)}" rpy="0 ${-pi/2 + tr} 0"/>
    </joint>

    <xacro:zed_eye name="${name}" side="left" y="0.0315" width="${width}" height="${height}" fps="${fps}" depth="true"/>
    <!-- gz point clouds use x-forward axes: scripts/points_relay.py republishes /cam3/points in this frame -->
    <link name="${name}_left_cloud_frame"/>
    <joint name="${name}_link_to_left_cloud" type="fixed">
      <parent link="${name}_link"/><child link="${name}_left_cloud_frame"/><origin xyz="0.01325 0.0315 0"/>
    </joint>
    <!-- right eye: frame always, Gazebo sensor only when right is true (one image stream less) -->
    <xacro:zed_eye name="${name}" side="right" y="-0.0315" width="${width}" height="${height}" fps="${fps}" sensor="${right}"/>
  </xacro:macro>
</robot>
