<?xml version="1.0"?>
<sdf version="1.9">
  <world name="workcell">
    <physics name="default_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- required for camera sensors -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>
    <light type="point" name="work_light">
      <pose>0 0 2.2 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <attenuation><range>6</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
  

    <!-- pickable boxes: 25 mm cubes (the jaws open to 32.8 mm, no fingers), 20 g. Red and blue sit on the two pick spots of
         config/pick_sequence.yaml, turned to line up with the jaws there (joint_1 = 154.4 / 205.6 deg), green is extra for detection and the dataset. scripts/gripper.py attaches/detaches them. -->
    <model name="box_red">
      <pose>-0.05 0.12 0.7625 0 0 -0.4468</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>20</update_frequency>
      </plugin>
      <link name="link">
        <inertial><mass>0.02</mass><inertia><ixx>2.1e-6</ixx><iyy>2.1e-6</iyy><izz>2.1e-6</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>0.85 0.12 0.10 1</ambient><diffuse>0.85 0.12 0.10 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_blue">
      <pose>-0.05 -0.12 0.7625 0 0 0.4468</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>20</update_frequency>
      </plugin>
      <link name="link">
        <inertial><mass>0.02</mass><inertia><ixx>2.1e-6</ixx><iyy>2.1e-6</iyy><izz>2.1e-6</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>0.10 0.30 0.85 1</ambient><diffuse>0.10 0.30 0.85 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_green">
      <pose>-0.3 0.1 0.7625 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>20</update_frequency>
      </plugin>
      <link name="link">
        <inertial><mass>0.02</mass><inertia><ixx>2.1e-6</ixx><iyy>2.1e-6</iyy><izz>2.1e-6</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>0.10 0.65 0.20 1</ambient><diffuse>0.10 0.65 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <!-- hand-eye calibration board: 9 x 6 squares of 20 mm (8 x 5 inner corners; odd x even, so it has no 180 deg ambiguity) with a white 20 mm border, 0.16 x 0.22 m (gz maps the picture width along the box y side).
         Parked flat on the free table corner; scripts/handeye_calib.py moves it onto the pallet while calibrating. -->
    <model name="checkerboard">
      <pose>-0.40 -0.30 0.751 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>2e-4</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.16 0.22 0.002</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.16 0.22 0.002</size></box></geometry>
          <material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient>
            <pbr><metal><albedo_map>checkerboard.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr>
          </material></visual>
      </link>
    </model>

    <!-- ArUco calibration square (docs/print/aruco_square18.pdf): 18 x 18 cm, IDs 0-4 of DICT_4X4_50,
         marker 0 (40 mm) in the centre, 1-4 (45 mm) at (+-60, +-60) mm. Lies on the pallet, where the wrist camera looks from the start
         pose; visual only, so boxes placed on the pallet go through it. The picture is stored turned by 90 deg because
         Gazebo lays texture width along the box y side; this way the sheet's x axis points along world +x.
         On the real cell the sheet's place is what you measure with the TCP. scripts/aruco_locate.py uses it. -->
    <model name="aruco_sheet">
      <static>true</static>
      <pose>-0.05 0.0 0.771 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.18 0.18 0.002</size></box></geometry>
          <material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient>
            <pbr><metal><albedo_map>aruco_square18.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr>
          </material></visual>
      </link>
    </model>

    <!-- Gazebo GUI: 3D view opens at an angled pose instead of top-down -->
    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.85 0.88 0.92</background_color>
        <camera_pose>1.6 -1.8 1.5 0 0.4 2.3</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>
  </world>
</sdf>
